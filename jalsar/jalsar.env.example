# Jal-SAR runner settings (read by "python jalsar.py run" and RUN JAL-SAR.bat).
# The runner copies this file to jalsar.env on its first run; edit jalsar.env, not this one.
# One setting per line, NAME=value. Anything after # is a note.
# Options given on the command line win over this file.

# The date of interest, YYYY-MM-DD. RUN JAL-SAR.bat asks for it; leave empty here.
EVENT_DATE=

# Look for a Sentinel-1 pass from EVENT_DATE to this many days after it.
SEARCH_DAYS=3

# Per cent of the corridor the pass must cover.
MIN_COVERAGE=99.5

# Which models to run: rf, unet, terramind (comma separated).
MODELS=rf,unet,terramind

# on: also download a dry-season scene of the same orbit and make the
# change-detection (Otsu) baseline map. off: models only.
PRE_EVENT=off

# Month of the dry-season scene (2 = February, the project's own baseline).
PRE_EVENT_MONTH=2

# Download tile size in cells (1024 keeps each request well under Earth Engine's limit).
TILE_PX=1024
