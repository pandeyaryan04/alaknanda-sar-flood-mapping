  <tbody>{% for v in b.villages.villages %}<tr data-vi="{{ loop.index0 }}"{% if not b.print_mode %} title="Show {{ v.village }} on the map"{% endif %}><td>{{ v.village }}</td><td>{{ v.subdistrict }}</td><td>{{ v.district }}</td><td class="r">{{ "{:,}".format(v.worldpop_village) if v.worldpop_village is not none else "n/a" }}</td><td class="r">{{ "{:,.0f}".format(v.worldpop_in_flood) if v.worldpop_in_flood is not none else "n/a" }}</td><td>{% if v.risk_class %}<span class="sw" style="background:{{ b.risk_colours.get(v.risk_class, '#9ca3af') }}"></span>{{ v.risk_class }}{% else %}n/a{% endif %}</td><td class="r">{% if v.share_flooded is not none %}{{ "%.1f"|format(v.share_flooded * 100) }} %{% else %}n/a{% endif %}</td><td class="r">{{ "%.3f"|format(v.flood_km2) }}</td><td class="r">{{ "%.3f"|format(v.flood_high_trust_km2) }}</td>{% if not b.print_mode %}<td class="btn"><button type="button">Map</button></td>{% endif %}</tr>
  {% endfor %}</tbody>
</table>
<div class="pager" id="vt-pager"><button type="button" onclick="gjPage('vt',-1)">Previous</button><span id="vt-page"></span><button type="button" onclick="gjPage('vt',1)">Next</button></div>
{% elif b.villages and b.villages.villages %}
<p class="note">Villages whose area includes mapped flood, largest flood area first. "Share in flood" is the mapped flood as a share of the whole village area. "Inside or touching the mapped flood" does not mean damaged. Households and population are from the 2011 Census (Geological Survey of India village boundaries); a village without a census figure says so, and is never counted as zero.</p>
<div class="tools"><label for="vq">Search</label><input id="vq" type="search" placeholder="village, block or district" oninput="gjPage('vt',0)"><span id="vt-count"></span></div>
