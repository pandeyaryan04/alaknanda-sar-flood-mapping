{#- Jal-SAR flood bulletin. Every sentence of the bulletin is in this one file,
    so a Hindi version can be added later as a second template.
    The header colour is dark maroon. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jal-SAR flood bulletin, {{ b.event.date_long }}</title>
<style>
:root{--ink:#1a2332;--muted:#4b5563;--line:#d7dce2;--bg:#f5f6f8;--card:#ffffff;--head:{{ b.c.maroon }};
 --high:{{ b.c.trust[3] }};--med:{{ b.c.trust[2] }};--low:{{ b.c.trust[1] }};--blind:{{ b.c.trust[0] }}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Georgia,'Times New Roman',serif}
.wrap{max-width:1180px;margin:0 auto;padding:0 18px 40px}
header.rpt{background:var(--head);color:#fff;padding:22px 0 18px}
header.rpt .wrap{padding-bottom:0}
.word{font:bold 34px/1 Georgia,serif;letter-spacing:.6px}
.kind{font:14px Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:1.6px;opacity:.85;margin-top:6px}
header.rpt h1{font:normal 25px/1.25 Georgia,serif;margin:12px 0 6px}
.meta{font:14px/1.5 Arial,Helvetica,sans-serif;opacity:.92}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:20px 0}
.card{background:var(--card);border:1px solid var(--line);border-top:4px solid var(--head);padding:12px 14px}
.card .k{font:12.5px Arial,Helvetica,sans-serif;text-transform:uppercase;letter-spacing:1px;color:var(--muted)}
.card .n{font:bold 27px/1.2 Arial,Helvetica,sans-serif;margin-top:4px}
.card .s{font:13.5px/1.45 Arial,Helvetica,sans-serif;color:var(--muted)}
.summary{background:var(--card);border:1px solid var(--line);border-left:6px solid var(--head);padding:14px 18px;font-size:17px}
.summary p{margin:.4em 0}
.howto{background:#fbf7f8;border:1px solid #ead7db;padding:12px 18px;margin-top:14px;font:15px/1.55 Arial,Helvetica,sans-serif}
.howto h3{margin:4px 0 6px;color:var(--head)}
.howto ol{margin:6px 0 4px;padding-left:22px}
.howto li{margin:.3em 0}
h2,h3{break-after:avoid}
h2{font:bold 22px Georgia,serif;color:var(--head);border-bottom:2px solid var(--head);padding-bottom:4px;margin:32px 0 12px}
h3{font:bold 16px Arial,Helvetica,sans-serif;margin:18px 0 6px}
p.note,.note{font:14px/1.55 Arial,Helvetica,sans-serif;color:var(--muted)}
.about{font:14.5px/1.55 Arial,Helvetica,sans-serif;background:#f8fafc;border-left:4px solid #94a3b8;padding:8px 12px;margin:8px 0 12px}
.about b{color:#334155}
table{border-collapse:collapse;width:100%;font:14px/1.45 Arial,Helvetica,sans-serif;background:#fff}
th{background:#e9edf2;text-align:left;padding:7px 9px;border-bottom:1px solid var(--line)}
td{padding:6px 9px;border-bottom:1px solid var(--line);vertical-align:top}
tbody tr:nth-child(even){background:#fafbfc}
td.r,th.r{text-align:right;font-variant-numeric:tabular-nums}
tr.head-row td{font-weight:bold}
tr.tot-row td{font-weight:bold;background:#eef1f5}
#vt tbody tr{cursor:pointer}
#vt tbody tr:hover{background:#fdf2f4}
#vt tbody tr.sel{background:#fbe3e8;outline:2px solid var(--head)}
td.btn button,.vcard button{font:13px Arial;padding:3px 9px;border:1px solid var(--line);background:#fff;cursor:pointer}
details{background:#fff;border:1px solid var(--line);margin:10px 0;padding:0 14px}
details>summary{cursor:pointer;font:bold 15px Arial,Helvetica,sans-serif;padding:10px 0;color:var(--head)}
details[open]>summary{border-bottom:1px solid var(--line);margin-bottom:8px}
/* the map: wider than the text column, as tall as the screen allows */
.mapbox{background:#fff;border:1px solid var(--line);padding:8px;position:relative;
 width:min(1640px,calc(100vw - 28px));left:50%;transform:translateX(-50%)}
.mapframe{position:relative;aspect-ratio:2.45;max-height:80vh;min-height:380px;width:100%}
svg.gjmap{width:100%;height:100%;display:block;background:#eef0f2;touch-action:none;cursor:grab}
svg.gjmap.drag{cursor:grabbing}
.gjmap .v,.gjmap .spot,.gjmap .ibox{cursor:pointer}
.mapbox:fullscreen{width:100vw;left:0;transform:none;padding:6px;overflow:auto}
.mapbox:fullscreen .mapframe{aspect-ratio:auto;max-height:none;height:calc(100vh - 110px)}
.mapctl{position:absolute;top:10px;left:10px;display:flex;flex-direction:column;gap:4px;z-index:3}
.mapctl button,.layerbtn{width:34px;height:34px;font:bold 17px Arial;border:1px solid #9ca3af;background:#fff;cursor:pointer;border-radius:3px}
.layerbtn{width:auto;padding:0 12px;font:bold 14px Arial;position:absolute;top:10px;right:10px;z-index:3}
.panel{position:absolute;background:#fff;border:1px solid #9ca3af;box-shadow:0 2px 8px rgba(0,0,0,.18);
 font:14px/1.45 Arial,Helvetica,sans-serif;z-index:4;border-radius:3px}
.layers{top:50px;right:10px;width:270px;max-height:calc(100% - 60px);overflow:auto;padding:8px 12px;display:none}
.layers.open{display:block}
.layers label{display:block;margin:3px 0;cursor:pointer}
.layers .grp{font:bold 12.5px Arial;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin:8px 0 2px}
.vcard{bottom:44px;right:10px;width:330px;max-height:calc(100% - 100px);overflow:auto;padding:10px 12px;display:none}
.vcard.open{display:block}
.vcard h4{margin:0 26px 2px 0;font:bold 17px Georgia,serif;color:var(--head)}
.vcard .where{color:var(--muted);font-size:13.5px;margin-bottom:6px}
.vcard table{font-size:13.5px}
.vcard td{padding:3px 4px}
.vcard .x{position:absolute;top:6px;right:8px;border:none;background:none;font:bold 20px Arial;cursor:pointer;color:var(--muted)}
.vcard .acts{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.scalebar{position:absolute;left:12px;bottom:10px;font:bold 13px Arial;background:rgba(255,255,255,.85);padding:3px 6px;z-index:2;pointer-events:none}
.scalebar .bar{height:5px;background:#111827;margin-top:2px}
.north{position:absolute;right:14px;bottom:12px;z-index:2;pointer-events:none;text-align:center;font:bold 13px Arial}
.zoomlvl{position:absolute;left:54px;top:12px;font:12.5px Arial;color:var(--muted);background:rgba(255,255,255,.85);padding:2px 6px;z-index:2;pointer-events:none}
.legend{display:flex;flex-wrap:wrap;gap:6px 18px;font:14px Arial,Helvetica,sans-serif;margin:10px 2px 0}
.sw{display:inline-block;width:14px;height:14px;vertical-align:-2px;margin-right:5px;border:1px solid rgba(0,0,0,.25)}
.dot{border-radius:50%}
.insets{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:10px}
@media (max-width:700px){.insets{grid-template-columns:1fr}.vcard{width:calc(100% - 20px)}}
.inset{background:#fff;border:1px solid var(--line);padding:6px;cursor:pointer}
.inset svg{width:100%;height:auto;display:block;background:#eef0f2}
.inset .cap{font:14px Arial,Helvetica,sans-serif;margin-top:4px}
.tools{display:flex;gap:10px;align-items:center;margin:6px 0;font:14px Arial,Helvetica,sans-serif}
.tools input{flex:1;max-width:340px;padding:6px 8px;border:1px solid var(--line);font:14px Arial}
.pager{display:flex;gap:6px;align-items:center;margin:8px 0;font:14px Arial,Helvetica,sans-serif}
.pager button{padding:5px 11px;border:1px solid var(--line);background:#fff;cursor:pointer}
.pager button[disabled]{opacity:.4;cursor:default}
.tag{display:inline-block;padding:1px 6px;font:bold 12px Arial;color:#fff;border-radius:2px}
.fc{display:inline-block;width:19px;height:19px;margin-right:1px;vertical-align:middle;border:1px solid rgba(0,0,0,.15);
 font:bold 11px/19px Arial;text-align:center;color:#fff}
.limits li{margin:.35em 0}
dl.gloss{font:14.5px/1.55 Arial,Helvetica,sans-serif;margin:6px 0}
dl.gloss dt{font-weight:bold;margin-top:8px;color:#111827}
dl.gloss dd{margin:2px 0 0 18px}
footer.rpt{font:13px Arial,Helvetica,sans-serif;color:var(--muted);border-top:1px solid var(--line);margin-top:30px;padding-top:10px}
.pb{}
{% if b.print_mode %}
@page{size:A4;margin:13mm 12mm 17mm 12mm}
body{background:#fff;font-size:13px}
.wrap{max-width:none;padding:0}
header.rpt{padding:14px 12px 12px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
header.rpt .wrap{padding:0}
.summary{font-size:14px}
.howto,.about,dl.gloss{font-size:12px}
.card .n{font-size:20px}
.card .s{font-size:11.5px}
.cards{grid-template-columns:repeat(5,1fr);gap:8px;margin:12px 0}
h2{font-size:17px;margin-top:18px}
table{font-size:11.5px}
p.note,.note,.legend,.inset .cap{font-size:11.5px}
.insets{grid-template-columns:repeat(3,minmax(0,1fr))}
#vt{font-size:10.5px}
#vt td,#vt th{padding:3px 5px}
.mapbox{width:auto;left:0;transform:none}
.mapframe{aspect-ratio:auto;max-height:none;height:auto;min-height:0}
svg.gjmap{height:auto}
.pb{break-before:page}
tr,.card,.inset,.mapbox,.about{break-inside:avoid}
.mapctl,.tools,.pager,.layerbtn,.panel,.scalebar,.north,.zoomlvl,td.btn,th.btn{display:none}
.fc{width:15px;height:15px;font-size:9px;line-height:15px}
* {-webkit-print-color-adjust:exact;print-color-adjust:exact}
{% endif %}
</style>
</head>
<body>
<header class="rpt"><div class="wrap">
  <div class="word">Jal-SAR</div>
  <div class="kind">Flood bulletin, Alaknanda corridor (Rudraprayag to Rishikesh)</div>
  <h1>{{ b.event.label or "Sentinel-1 pass" }}: {{ b.event.date_long }}</h1>
  <div class="meta">
    Radar: Sentinel-1, relative orbit {{ b.event.orbit }}, {{ b.event.orbit_pass|lower }} pass{% if b.event.scene_time_utc %}, acquired {{ b.event.scene_time_utc }} UTC{% endif %}.
    {% if b.event.scene_id %}Scene {{ b.event.scene_id }}.{% endif %}<br>
    Made {{ b.made }} with Jal-SAR {{ b.version }}. Headline model: {{ b.head.name }}.
  </div>
</div></header>

<div class="wrap">

{% set fc_warn = b.forecast|selectattr("day1", "equalto", "warning")|list|length if b.forecast else 0 %}
{% set fc_watch = b.forecast|selectattr("day1", "equalto", "watch")|list|length if b.forecast else 0 %}
<div class="cards">
  <div class="card"><div class="k">Mapped flood area</div><div class="n">{{ b.fmt.area_total }} km&sup2;</div>
    <div class="s">outside the river's usual channel</div></div>
  <div class="card" style="border-top-color:var(--high)"><div class="k">High-trust share</div><div class="n">{{ b.fmt.high_pct }}</div>
    <div class="s">{{ b.fmt.area_high }} km&sup2; on terrain graded high</div></div>
  <div class="card"><div class="k">Villages touching the flood</div><div class="n">{{ b.fmt.n_villages }}</div>
    {% if b.worldpop %}<div class="s">{{ b.fmt.wp_in_flood }} people inside the mapped flood; {{ b.fmt.wp_villages }} live in these villages (WorldPop 2020)</div>
    {% else %}<div class="s">population {{ b.fmt.population }} (Census 2011){% if b.fmt.n_villages_min != "n/a" %};
    {{ b.fmt.n_villages_min }} with at least {{ b.fmt.min_ha }} ha of flood (population {{ b.fmt.population_min }}){% endif %}</div>{% endif %}</div>
  <div class="card"><div class="k">Road length in the flood</div><div class="n">{{ b.fmt.road_km }}</div>
    <div class="s">{% if b.roads %}km of OpenStreetMap roads{% else %}roads not available{% endif %}</div></div>
  {% if b.forecast %}<div class="card" style="border-top-color:{{ b.forecast_cols.warning if fc_warn else (b.forecast_cols.watch if fc_watch else b.forecast_cols.none) }}"><div class="k">River forecast, day before</div>
    <div class="n">{{ fc_warn + fc_watch }} of {{ b.forecast|length }}</div>
    <div class="s">gauges where GloFAS forecast at least the 2-year flow one day ahead{% if fc_warn %} ({{ fc_warn }} at the 5-year flow){% endif %}</div></div>{% endif %}
</div>

<div class="summary">
  <p>Sentinel-1 radar passed over the corridor on {{ b.event.date_long }}. The {{ b.head.name }} model maps
  <b>{{ b.fmt.area_total }} km&sup2;</b> of flood water outside the river's usual channel.
  Of that, {{ b.fmt.area_high }} km&sup2; is on terrain where trust in the map is high,
  {{ b.fmt.area_med }} km&sup2; medium and {{ b.fmt.area_low }} km&sup2; low.{% if b.ts_high %} {{ b.ts_high }}{% endif %}</p>
  {% if b.villages and b.worldpop %}<p>{{ b.fmt.n_villages }} village{{ "s have" if b.villages.count != 1 else " has" }} part of their area inside the mapped flood. WorldPop 2020 puts {{ b.fmt.wp_in_flood }} people on the mapped flood itself and {{ b.fmt.wp_villages }} in these villages (the parts inside the corridor).{% if b.fmt.n_villages_min != "n/a" %} {{ b.fmt.n_villages_min }} of them have at least {{ b.fmt.min_ha }} ha ({{ b.fmt.min_km2 }} km&sup2;) of mapped flood, with {{ b.fmt.wp_min_area }} people.{% endif %} WorldPop is a modelled estimate, not a count; the 2011 Census figures are in the village table file ({{ b.villages_csv }}).</p>
  {% elif b.villages %}<p>{{ b.fmt.n_villages }} village{{ "s have" if b.villages.count != 1 else " has" }} part of their area inside the mapped flood. Together they had {{ b.fmt.population }} people in {{ b.fmt.households }} households at the 2011 Census{% if b.villages.without_census_figure %} ({{ b.villages.without_census_figure }} of them have no census figure){% endif %}.{% if b.fmt.n_villages_min != "n/a" %} {{ b.fmt.n_villages_min }} of them have at least {{ b.fmt.min_ha }} ha ({{ b.fmt.min_km2 }} km&sup2;) of mapped flood, with {{ b.fmt.population_min }} people.{% endif %} Population is for the whole village, not for the people inside the mapped flood.</p>{% endif %}
  {% if b.roads %}<p>{{ b.fmt.road_km }} km of mapped roads lie inside the mapped flood{% if b.roads.top_named %}, most on {{ b.roads.top_named[0].name }} ({{ "%.2f"|format(b.roads.top_named[0].flood_km) }} km){% endif %}.</p>{% endif %}
  <p>{{ b.fmt.blind }} km&sup2; of the corridor is radar blind on this pass (slopes in layover or shadow); no flood can be mapped there.</p>
  {% if b.forecast %}<p>In the GloFAS river forecast issued the day before the pass, {% if fc_warn + fc_watch %}{{ fc_warn + fc_watch }} of the {{ b.forecast|length }} gauge points were at or above the 2-year flow{% if fc_warn %} ({{ fc_warn }} at or above the 5-year flow){% endif %}{% else %}none of the {{ b.forecast|length }} gauge points reached the 2-year flow{% endif %} (section "River forecast before this pass").</p>{% endif %}
  {% if b.validation %}<p>For this event the map was checked against hand-drawn reference maps of {{ b.validation.year }}: F1 {{ b.fmt.f1_a }} for the model trained on Sen1Floods11 (Table A) and {{ b.fmt.f1_d }} when trained on the corridor itself (Table D). An F1 of 1 would be a perfect match.</p>
  {% else %}<p>There is no reference map for this date, so this map has not been checked directly. On the two checked events (2021 and 2023) the {{ b.head.name }} model scored F1 {{ b.fmt.f1_mean_d }} on average (Table D).</p>{% endif %}
</div>

<div class="howto">
  <h3>How to read this bulletin</h3>
  <ol>
    <li><b>The flood map.</b> Coloured cells are where the radar saw water that is not normally there. Blue, orange and red say how far the map can be trusted on that kind of ground (high, medium, low). Grey is ground the radar could not see on this pass.</li>
    {% if b.print_mode %}<li><b>The interactive version.</b> The HTML file of this bulletin can be zoomed to 10 m detail. There, a click on a village dot shows its details, and the Layers button switches on each model's map, the model agreement and village risk colours.</li>
    {% else %}<li><b>Use the map.</b> Scroll or use + and &minus; to zoom, drag to move. Click a village dot for its details, click a box A, B or C to jump to that close-up, and open <b>Layers</b> to switch on each model's map, the model agreement or village risk colours. The fourth button on the left shows the map on the whole screen (Esc to leave).</li>{% endif %}
    <li><b>Villages.</b> A village is listed when part of its land is inside the mapped flood. That does not mean it was damaged.{% if not b.print_mode %} Click a row in the village table to see the village on the map.{% endif %}</li>
    <li><b>Numbers of people</b> are WorldPop 2020 estimates on a grid of about 100 m, not a head count. Census 2011 figures are in the village file.</li>
    <li><b>How good is the map?</b> The section "How far the map has been checked" gives the scores against hand-drawn flood maps. Treat the map as a guide to where to look, not as a survey.</li>
    <li><b>Words you may not know</b> (HAND, F1, CSI, layover, 2-year flow) are explained in the glossary at the end.</li>
  </ol>
</div>

<h2 class="pb">Map</h2>
<div class="mapbox" id="mapbox">
 <div class="mapframe" id="mapframe">
  <svg class="gjmap" id="gjmap" viewBox="0 0 {{ b.map.w }} {{ b.map.h }}" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
    {% if b.map.hillshade %}<image class="lyr-hs" href="{{ b.map.hillshade }}" x="0" y="0" width="{{ b.map.w }}" height="{{ b.map.h }}" preserveAspectRatio="none" opacity="0.9"/>{% endif %}
    <image class="lyr-blind" href="{{ b.map.blind }}" x="0" y="0" width="{{ b.map.w }}" height="{{ b.map.h }}" preserveAspectRatio="none" style="image-rendering:pixelated"/>
    {% if b.map.corridor %}<path class="lyr-outside" d="M0,0 H{{ b.map.w }} V{{ b.map.h }} H0 Z {{ b.map.corridor }}" fill="#ffffff" fill-opacity="0.55" fill-rule="evenodd"/>{% endif %}
    <path class="lyr-corr" d="{{ b.map.corridor }}" fill="none" stroke="{{ b.c.maroon }}" stroke-width="{{ b.map.stroke }}" stroke-dasharray="{{ b.map.stroke * 4 }} {{ b.map.stroke * 3 }}" data-sw="2" data-dash="8 6"/>
    <image class="lyr-flood" href="{{ b.map.flood }}" x="0" y="0" width="{{ b.map.w }}" height="{{ b.map.h }}" preserveAspectRatio="none" style="image-rendering:pixelated"/>
    {% if not b.print_mode %}{% if b.map.agree %}<image class="lyr-agree" href="{{ b.map.agree }}" x="0" y="0" width="{{ b.map.w }}" height="{{ b.map.h }}" preserveAspectRatio="none" style="image-rendering:pixelated;display:none"/>{% endif %}
    {% for m in b.map.model_layers %}<image class="lyr-{{ m.id }}" href="{{ m.png }}" x="0" y="0" width="{{ b.map.w }}" height="{{ b.map.h }}" preserveAspectRatio="none" style="image-rendering:pixelated;display:none"/>
    {% endfor %}{% endif %}
    <g class="lyr-spots">
    {% for s in b.map.spots %}<circle class="spot" data-si="{{ loop.index0 }}" data-px="{{ s.px }}" cx="{{ s.x }}" cy="{{ s.y }}" r="{{ s.r }}" fill="{{ s.col }}" fill-opacity="0.35" stroke="{{ s.col }}" stroke-width="{{ b.map.stroke * 0.6 }}" data-sw="1.2"><title>{{ "%.3f"|format(s.km2) }} km² of mapped flood in this 1 km square, {{ s.trust }} trust for most of it</title></circle>
    {% endfor %}</g>
    {% if b.map.split_x is not none %}<g class="lyr-split"><line x1="{{ b.map.split_x }}" y1="0" x2="{{ b.map.split_x }}" y2="{{ b.map.h }}" stroke="#374151" stroke-width="{{ b.map.stroke * 0.8 }}" stroke-dasharray="{{ b.map.stroke * 2 }} {{ b.map.stroke * 2 }}" data-sw="1.5" data-dash="5 5"/>
    <text id="lbl-gorge" x="{{ b.map.split_x + b.map.stroke * 4 }}" y="{{ b.map.font * 1.4 }}" font-family="Arial" font-size="{{ b.map.font }}" fill="#374151" data-fs="14">Gorge above Devprayag &#8594;</text>
    <text id="lbl-valley" x="{{ b.map.split_x - b.map.stroke * 4 }}" y="{{ b.map.font * 1.4 }}" font-family="Arial" font-size="{{ b.map.font }}" fill="#374151" text-anchor="end" data-fs="14">&#8592; Open valley below Devprayag</text></g>{% endif %}
    <g class="lyr-villages">
    {% for v in b.map.villages %}<circle class="v" data-vi="{{ v.i }}" data-px="{{ v.px }}" cx="{{ v.x }}" cy="{{ v.y }}" r="{{ v.r }}" fill="#fff" data-rcol="{{ v.rcol }}" fill-opacity="0.85" stroke="{{ b.c.maroon }}" stroke-width="{{ b.map.stroke * 0.7 }}" data-sw="1.4"><title>{{ v.name }} ({{ v.sub }}): {{ "%.3f"|format(v.flood) }} km&sup2; of mapped flood, {{ "%.1f %%"|format(v.share * 100) if v.share is not none else "n/a" }} of the whole village area{% if v.wp_v is not none %}; {{ "{:,}".format(v.wp_v) }} people (WorldPop 2020){% elif v["pop"] is not none %}; population {{ "{:,}".format(v["pop"]) }} (Census 2011){% endif %}{% if not b.print_mode %}. Click for details.{% endif %}</title></circle>
    {% endfor %}</g>
    <circle id="gj-sel" cx="-999" cy="-999" r="1" fill="none" stroke="#111827" stroke-width="3" vector-effect="non-scaling-stroke" style="display:none;pointer-events:none"/>
    <g class="lyr-boxes">
    {% for i in b.map.insets %}<rect class="ibox" data-box="{{ loop.index0 }}" x="{{ i.x }}" y="{{ i.y }}" width="{{ i.w }}" height="{{ i.h }}" fill="#ffffff" fill-opacity="0.01" stroke="#111827" stroke-width="{{ b.map.stroke }}" data-sw="2"><title>Close-up {{ i.key }}: click to zoom here</title></rect>
    <text class="ilbl" data-box="{{ loop.index0 }}" x="{{ i.x + i.w / 2 }}" y="{{ i.y - b.map.stroke * 3 }}" font-family="Arial" font-weight="bold" font-size="{{ b.map.font * 1.2 }}" text-anchor="middle" fill="#111827" data-fs="16" style="pointer-events:none">{{ i.key }}</text>{% endfor %}</g>
    {% if b.print_mode %}<g transform="translate({{ b.map.w - b.map.font * 2.5 }},{{ b.map.h - b.map.font * 5 }})">
      <path d="M0,{{ -b.map.font * 2 }} L{{ b.map.font * 0.7 }},0 L0,{{ -b.map.font * 0.6 }} L{{ -b.map.font * 0.7 }},0 Z" fill="#111827"/>
      <text x="0" y="{{ b.map.font * 1.2 }}" font-family="Arial" font-size="{{ b.map.font }}" text-anchor="middle" fill="#111827">N</text></g>
    <g transform="translate({{ b.map.w - b.map.font * 5 - b.map.scale_px }},{{ b.map.h - b.map.font * 2 }})">
