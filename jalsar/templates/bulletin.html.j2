  <thead><tr><th>Village</th><th>Sub-district</th><th>District</th><th class="r">Households (2011)</th><th class="r">Population (2011)</th><th class="r">Share in flood</th><th class="r">Flood (km&sup2;)</th><th class="r">of it high trust</th>{% if not b.print_mode %}<th class="btn"></th>{% endif %}</tr></thead>
  <tbody>{% for v in b.villages.villages %}<tr data-vi="{{ loop.index0 }}"{% if not b.print_mode %} title="Show {{ v.village }} on the map"{% endif %}><td>{{ v.village }}</td><td>{{ v.subdistrict }}</td><td>{{ v.district }}</td><td class="r">{{ "{:,}".format(v.households_2011) if v.households_2011 is not none else "no census figure" }}</td><td class="r">{{ "{:,}".format(v.population_2011) if v.population_2011 is not none else "no census figure" }}</td><td class="r">{% if v.share_flooded is not none %}{{ "%.1f"|format(v.share_flooded * 100) }} %{% else %}n/a{% endif %}</td><td class="r">{{ "%.3f"|format(v.flood_km2) }}</td><td class="r">{{ "%.3f"|format(v.flood_high_trust_km2) }}</td>{% if not b.print_mode %}<td class="btn"><button type="button">Map</button></td>{% endif %}</tr>
