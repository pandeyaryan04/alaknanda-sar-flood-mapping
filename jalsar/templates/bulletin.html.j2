    {% if b.worldpop and not b.print_mode %}{% for k, lab in [("high", "high risk"), ("medium", "medium risk"), ("low", "low risk"), ("flooded, no one mapped inside", "flood, but no people mapped on it"), ("no vulnerability class", "no vulnerability class")] %}<span data-for="vrisk" style="display:none"><span class="sw dot" style="background:{{ b.risk_colours[k] }};border-color:{{ b.c.maroon }}"></span>{{ lab }}</span>
