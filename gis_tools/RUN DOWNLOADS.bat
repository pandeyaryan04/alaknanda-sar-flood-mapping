@echo off
for %%I in ("%~dp0..\..") do set "PROJ=%%~fI"
rem gis_tools: scripted downloads
rem Generated by gis_tools. Double-click it; do not run it from a prompt.

chcp 65001 >nul
set PYTHONUTF8=1
cd /d "%~dp0"

echo.
echo gis_tools: scripted downloads
echo.

call "%USERPROFILE%\miniconda3\Scripts\activate.bat" "%USERPROFILE%\miniconda3" >nul 2>&1
call conda activate fyp
if errorlevel 1 (
  echo.
  echo Could not activate the conda environment 'fyp'.
  echo.
  echo   1. Open Anaconda Prompt
  echo   2. Type:  conda env list
  echo   3. If 'fyp' is not listed, create it from
  echo      04 Code\FYP_code\environment.yml
  echo.
  pause
  exit /b 1
)


echo Which one?
echo.
echo   1  find the partner date for 20 July 2023
echo   2  Sentinel-1 timing near 19 June 2021
echo   3  submit ASF HyP3 RTC for the post scenes
echo   4  check HMA 8 m DEM coverage, no download
echo   5  IMD gridded rainfall 2020-2024
echo   0  just run the self-test
echo.
set /p pick=Type a number and press Enter:

if "%pick%"=="1" python t07_download.py gee-inventory --start 2023-07-10 --end 2023-07-30
if "%pick%"=="2" python t07_download.py gee-s1-timing --date 2021-06-19 --window 10
if "%pick%"=="3" python t07_download.py asf --scenes-file "%PROJ%\05 Data\sentinel1_rtc_scenes.txt"
if "%pick%"=="4" python t07_download.py earthdata --short-name HMA_DEM8m_MOS
if "%pick%"=="5" python t07_download.py imd --years 2020-2024
if "%pick%"=="0" python t07_download.py selftest

echo.
pause
