# gis_tools configuration.
# Copy to .env and edit. Every tool reads this file and nothing else.
# Windows paths, backslashes, no quotes. ${NAME} expands to a key set above it.

# ---------------------------------------------------------------- locations
PROJECT_ROOT       = <project folder>
DATA_DIR           = ${PROJECT_ROOT}\05 Data
CODE_DIR           = ${PROJECT_ROOT}\04 Code
OUT_DIR            = ${PROJECT_ROOT}\06 Outputs\gis_tools
CORRIDOR           = ${CODE_DIR}\FYP_code\data\corridor.geojson
S2_DIR             = ${DATA_DIR}\sentinel2
DEM_DIR            = ${DATA_DIR}\dem
LANDCOVER_DIR      = ${DATA_DIR}\landcover

# The DEM used for routing and for the elevation check. Corridor-clipped is
# fine: the method is a least-cost path between fixed endpoints, not flow
# accumulation, so it needs no upstream catchment.
DEM_ROUTING        = ${DEM_DIR}\DEM_COP_GLO30_30m.tif

CENTRELINE_OUT     = ${DATA_DIR}\boundaries\corridor_centreline.geojson
# Second copy, because REFERENCE-how-to-digitise and DATA-what-is-left name
# different paths for the same file. Blank to skip.
CENTRELINE_COPY    = ${CODE_DIR}\FYP_code\data\centreline.geojson

RIVER_NAME         = Alaknanda-Ganga, Rudraprayag to Rishikesh

# ------------------------------------------------------------ coordinates
# CRS_METRIC must be the UTM zone the corridor actually sits in. The
# self-test checks this against ANCHOR_UP and fails if they disagree.
CRS_METRIC         = EPSG:32644
CRS_STORE          = EPSG:4326

# --------------------------------------------------------- band contract
# Verified against 04 Code\gee\03_export_remaining.js on 9 September 2026.
S2_BANDS           = B2,B3,B4,B8,B11,SCL
S2_SCALE           = 10000
IDX_BANDS          = MNDWI,NDWI
SCL_NODATA         = 0
SCL_CLOUD          = 3,8,9,10
SCL_SNOW           = 11

# ------------------------------------------------------------- scene lists
# File stems. The tools append _10m.tif and _indices_10m.tif.
DRY_SCENES         = S2_2021_dry_a_20210208,S2_2021_dry_b_20210210,S2_2023_dry_a_20230203,S2_2023_dry_b_20230205

# Mosaic pairs, primary date first. The primary wins wherever it is clear.
PAIR_2021_EVENT    = S2_2021_ref_20211021,S2_2021_ref_alt_20211023
PAIR_2023_EVENT    = S2_2023_ref_20230819,S2_2023_ref_alt_20230817
PAIR_2021_DRY      = S2_2021_dry_a_20210208,S2_2021_dry_b_20210210
PAIR_2023_DRY      = S2_2023_dry_a_20230203,S2_2023_dry_b_20230205
# Fill in once the partner date for 20 July 2023 is known (RUN DOWNLOADS.bat, option 1).
PAIR_2023JUL_EVENT =
MOSAIC_SETS        = PAIR_2021_EVENT,PAIR_2023_EVENT,PAIR_2021_DRY,PAIR_2023_DRY,PAIR_2023JUL_EVENT
# Which of those get a QGIS project built for them by t05.
QGIS_EVENTS        = PAIR_2021_EVENT,PAIR_2023_EVENT,PAIR_2023JUL_EVENT
MIN_MOSAIC_CLEAR   = 99.5

# ------------------------------------------------------------------ anchors
# lon,lat. Taken from FALLBACK_ANCHORS in 05_reference_windows.py, which took
# them from 01_export_s1.js. Approximate town positions, which is why the
# endpoints are snapped to the water mask before routing.
ANCHOR_UP          = 78.9811,30.2844
ANCHOR_DOWN        = 78.2676,30.0869
ANCHOR_SRINAGAR    = 78.7833,30.2222
ANCHOR_DEVPRAYAG   = 78.5981,30.1469
CHECK_TOWNS        = ANCHOR_SRINAGAR,ANCHOR_DEVPRAYAG

# ------------------------------------------------------------ water mask
# Union over DRY_SCENES of (MNDWI > MNDWI_WATER) and (B11 < SWIR_WATER) and
# SCL clear. The SWIR condition is what separates water from terrain shadow:
# shadowed rock is dark in the visible bands but still returns SWIR.
MNDWI_WATER        = 0.00
SWIR_WATER         = 0.03
MIN_WATER_HA       = 2.0

# ------------------------------------------------------------------ routing
SNAP_RADIUS_M      = 500
LAND_COST          = 1.0
WATER_COST         = 0.05
# How strongly the path is pulled to the middle of the channel. This is what
# makes it a centreline, and it is why a wide reservoir needs no special case.
CENTRE_WEIGHT      = 8.0
CENTRE_REF_M       = 120
CLIMB_WEIGHT       = 40.0

# -------------------------------------------------------------- smoothing
SIMPLIFY_M         = 20
CHAIKIN_PASSES     = 2
VERTEX_MAX_M       = 200

# -------------------------------------------------------- acceptance tests
LENGTH_MIN_KM      = 90
LENGTH_MAX_KM      = 130
INSIDE_MIN_FRACTION= 0.999
TOWN_TOL_M         = 1500
OFFSET_MEDIAN_MAX_M= 250
ELEV_NOISE_M       = 5
ELEV_BAD_MAX_FRACTION = 0.02
QC_STEP_M          = 100
MAX_HALF_WIDTH_M   = 2000
RESERVOIR_WIDTH_M  = 400

# The 9 September decision: leave corridor.geojson alone. Setting this true
# rebuilds the 5 km buffer from the new centreline and invalidates every
# raster already clipped to the old one.
REBUILD_CORRIDOR   = false
CORRIDOR_BUFFER_M  = 5000

# -------------------------------------------------- water mask audit (t03)
WATERMASK_LAYERS   = LULC50K_corridor_clip.geojson
LULC_WATER_FIELD   = DESCR_2
LULC_WATER_VALUE   = River / Stream / Canals
JRC_OCCURRENCE     = ${DEM_DIR}\WATER_JRC_occurrence_30m.tif
JRC_MIN_OCCURRENCE = 50
TRANSECT_SPACING_M = 500
# Half-width of each audit panel, metres.
PANEL_HALF_M       = 1500
PANEL_SITES        = 78.95,30.28; 78.83,30.25; 78.78,30.22; 78.60,30.15; 78.45,30.12; 78.30,30.10

# ----------------------------------------------------------- reservoir (t04)
RESERVOIR_AOI      =
RESERVOIR_TOL_PCT  = 10
# Only used when RESERVOIR_AOI is blank and the AOI is found automatically.
RESERVOIR_GROW_M   = 600
RESERVOIR_MARGIN_M = 200
RESERVOIR_SCENES   = S2_2021_dry_a_20210208,S2_2023_dry_a_20230203,S2_2021_ref_20211021,S2_2023_ref_20230819

# ------------------------------------------------------- draft polygons (t06)
WINDOWS_2021       = ${CODE_DIR}\FYP_code\data\reference_windows_2021\reference_windows.geojson
WINDOWS_2023       = ${CODE_DIR}\FYP_code\data\reference_windows_2023\reference_windows.geojson
HILLSHADE_MIN      = 0.15
SUN_AZIMUTH        = 150
SUN_ELEVATION      = 55
MIN_POLY_HA        = 0.09
MARGIN             = 0.05
# tag:scene_stem, one per pass you want drafted. The tag picks WINDOWS_<TAG>.
DRAFT_SETS         = 2021:S2_2021_ref_20211021,2021:S2_2021_dry_a_20210208,2023:S2_2023_ref_20230819,2023:S2_2023_dry_a_20230203

# ------------------------------------------------------------- downloads (t07)
GEE_PROJECT        = gbpuat-fyp-alaknanda
GEE_DRIVE_FOLDER   = FYP_exports

# ---------------------------------------------------------------- behaviour
LOG_LEVEL          = INFO
FORCE              = false
